{
  "rewrites": [
    { "source": "/v2", "destination": "/v2/index.html" },
    { "source": "/v2/", "destination": "/v2/index.html" },
    { "source": "/api/v2/pricing/signals", "destination": "/api/v2/price-signals" },
    { "source": "/api/v2/matching/:id", "destination": "/api/v2/buyer-matches?listingId=:id" },
    { "source": "/api/v2/ai/drafts/:id/confirm", "destination": "/api/v2/ai/drafts/:id" },
    { "source": "/api/v2/ai/drafts/:id/reject", "destination": "/api/v2/ai/drafts/:id" }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "db/migrations/**"
    }
  }
}
