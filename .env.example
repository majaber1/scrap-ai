# Copy to .env.local for `npm run serve` against a real database.
# Never commit real secrets. Vercel Production / Preview / Development must set the same keys.

# Required for accounts, listings, offers, pickups
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/scrap_ai?sslmode=require
SESSION_SECRET=replace-with-at-least-32-character-secret

# Optional: indicative image analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional: listing photos on Vercel Blob (preferred)
BLOB_READ_WRITE_TOKEN=

# Optional: Cloudflare R2 instead of Blob
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: only when a licensed payment provider is contracted
PSP_PROVIDER=
